{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InsectAgentPattern",
  "type": "object",
  "required": ["id","organism","order","mechanism","biological_observation","abstract_rule","agent_mapping","uses","failure_modes","research_seed","evidence_ids","confidence"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Z]+-[0-9]{3}$"},
    "organism": {"type":"string"},
    "order": {"type":"string"},
    "mechanism": {"type":"string"},
    "biological_observation": {"type":"string"},
    "abstract_rule": {"type":"array","items":{"type":"string"}},
    "agent_mapping": {"type":"object"},
    "uses": {"type":"array","items":{"type":"string"}},
    "failure_modes": {"type":"array","items":{"type":"string"}},
    "research_seed": {"type":"string"},
    "evidence_ids": {"type":"array","items":{"type":"string"}},
    "confidence": {"enum":["high","medium_high","medium","low"]}
  }
}
